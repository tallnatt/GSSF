# Apache configuration for GSSF Family Match Tracker
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block direct web access to internal directories and sensitive files
    RewriteRule ^(data|src)/ - [F,L]
    RewriteRule ^(config\.php|config\.local\.php|schema\.sql|README\.md|apache-vhost\.conf)$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.local\.php|schema\.sql|apache-vhost\.conf)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
